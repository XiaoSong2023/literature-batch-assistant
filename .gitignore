# This folder also holds personal bibliographies, downloads, outputs and old builds.
# Only the project itself is versioned: everything else is ignored by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/package.json
!/package-lock.json
!/extension/
!/tests/
!/tools/
!/docs/

# A private starting list (generated by tools/extract_bibliography.py) never leaves this machine.
/extension/bundled-papers.json

# Machine-specific helpers and generated test evidence (contain local paths).
/tools/verify_installed_extension.mjs
/tests/installed-directory-*.json
/tests/*-result.json
/tests/*-failure.json
/tests/*-output.txt
/tests/*-summary.json
/tests/*.png

node_modules/
dist/
__pycache__/
