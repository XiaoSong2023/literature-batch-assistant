{
  "manifest_version": 3,
  "name": "文献全文批量助手",
  "version": "1.5.0",
  "description": "按清单检索 DOI 或下载 PDF 直链，核验浏览器下载结果，并导出未获取全文的文献。",
  "minimum_chrome_version": "120",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "permissions": ["storage", "unlimitedStorage", "downloads", "alarms", "tabs", "scripting", "webNavigation"],
  "host_permissions": ["https://sci-hub.box/*", "https://sci-net.xyz/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "打开文献全文批量助手", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "options_page": "dashboard.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
